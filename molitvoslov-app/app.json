{
  "expo": {
    "name": "Молитвослов",
    "slug": "molitvoslov",
    "scheme": "molitvoslov",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/branding/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.accepted2.molitvoslov"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7ECD8",
        "foregroundImage": "./assets/branding/app-icon.png"
      },
      "package": "com.accepted2.molitvoslov",
      "versionCode": 9
    },
    "web": {
      "favicon": "./assets/branding/app-icon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Разрешить Молитвослову добавлять фотографии записок в помянник.",
          "cameraPermission": "Разрешить Молитвослову фотографировать записки для помянника.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.451725030385-vb72u6k4hool18blesrbesollv7fphmk"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7ECD8",
          "image": "./assets/branding/app-icon.png",
          "imageWidth": 150,
          "resizeMode": "contain"
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": ["./assets/fonts/Ponomar-Regular.ttf"],
          "widgets": [
            {
              "name": "QuoteOfDay",
              "label": "Цитата дня",
              "description": "Ежедневная цитата из приложения Молитвослов",
              "minWidth": "120dp",
              "minHeight": "40dp",
              "targetCellWidth": 3,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 3600000,
              "widgetFeatures": "reconfigurable"
            },
            {
              "name": "ChurchCalendar",
              "label": "Церковный календарь",
              "description": "Дата, память дня, пост и календарь месяца",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 3600000
            }
          ]
        }
      ],
      "expo-font"
    ],

    "owner": "anatoliy1",
    "extra": {
      "eas": {
        "projectId": "327409b7-2571-426f-96e7-58350b2e689c"
      }
    }
  }
}
